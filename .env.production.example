# =============================================================================
# AEMS — PRODUCTION ENVIRONMENT (Sprint 11)
# Copy: cp .env.production.example .env.production
# NEVER commit .env.production with real secrets
# =============================================================================

PROJECT_NAME=AEMS
ENVIRONMENT=production
AEMS_VERSION=11.0.0
TZ=Asia/Ho_Chi_Minh
DOMAIN=your-domain.example.com

# PostgreSQL
POSTGRES_USER=aems
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=aems
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aems:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/aems

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_DB=0

# JWT / Security
SECRET_KEY=CHANGE_ME_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080
JWT_ALGORITHM=HS256
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
RATE_LIMIT_PER_MINUTE=120
ENABLE_METRICS=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=https://your-domain.example.com
LOG_LEVEL=INFO
LOG_DIR=/app/logs
AEMS_REALTIME_DEMO=false

# DB Pool (Sprint 10)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_PRE_PING=true

# Frontend (built into nginx path)
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=wss://your-domain.example.com/api/v1/ws

# Telegram alerts (Watchdog + Event module)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA
GRAFANA_ROOT_URL=https://your-domain.example.com:3000

# Retention (days) — configurable
RETENTION_SNAPSHOT_DAYS=30
RETENTION_VIDEO_DAYS=30
RETENTION_LOG_DAYS=90
RETENTION_EVENT_DAYS=365

# Watchdog
WATCHDOG_BACKEND_URL=http://backend:8000
WATCHDOG_INTERVAL_S=30
