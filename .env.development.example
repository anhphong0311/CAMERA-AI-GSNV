# AEMS — DEVELOPMENT ENVIRONMENT (Sprint 11)
# Use root .env.example for docker-compose dev stack
PROJECT_NAME=AEMS
ENVIRONMENT=development
AEMS_VERSION=11.0.0-dev
TZ=Asia/Ho_Chi_Minh

POSTGRES_USER=aems
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=aems
DATABASE_URL=postgresql+asyncpg://aems:dev_password@localhost:5432/aems

REDIS_HOST=localhost
REDIS_PASSWORD=dev_redis
SECRET_KEY=dev_secret_not_for_production
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=DEBUG
AEMS_REALTIME_DEMO=true
DEBUG=true
