# AEMS — STAGING ENVIRONMENT (Sprint 11)
PROJECT_NAME=AEMS
ENVIRONMENT=staging
AEMS_VERSION=11.0.0-staging
TZ=Asia/Ho_Chi_Minh
DOMAIN=staging.aems.local

POSTGRES_USER=aems
POSTGRES_PASSWORD=staging_db_password
POSTGRES_DB=aems_staging
DATABASE_URL=postgresql+asyncpg://aems:staging_db_password@postgres:5432/aems_staging

REDIS_HOST=redis
REDIS_PASSWORD=staging_redis_password

SECRET_KEY=staging_secret_change_me
BACKEND_CORS_ORIGINS=https://staging.aems.local
LOG_LEVEL=DEBUG
AEMS_REALTIME_DEMO=false

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=staging_grafana
