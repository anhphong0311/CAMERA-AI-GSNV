# =============================================================================
# AEMS - ROOT ENVIRONMENT (dùng chung cho docker-compose)
# Copy file này thành `.env` và điều chỉnh giá trị thực tế.
# KHÔNG commit file `.env` thật lên git (đã nằm trong .gitignore).
# =============================================================================

# ----- Chung -----
PROJECT_NAME=AEMS
ENVIRONMENT=development            # development | staging | production
TZ=Asia/Ho_Chi_Minh

# ----- PostgreSQL -----
POSTGRES_USER=aems
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=aems
POSTGRES_HOST=postgres            # tên service trong docker-compose
POSTGRES_PORT=5432

# ----- Redis -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_DB=0

# ----- Backend / JWT -----
# Sinh khóa mạnh: `openssl rand -hex 32`
SECRET_KEY=change_me_generate_a_64_char_hex_secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080   # 7 ngày
JWT_ALGORITHM=HS256

# ----- Backend server -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ----- Frontend -----
# URL backend mà frontend gọi tới (qua Nginx trong production).
VITE_API_BASE_URL=http://localhost:8080/api/v1
