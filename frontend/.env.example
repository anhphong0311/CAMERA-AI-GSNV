# API base URL — backend FastAPI (qua Nginx hoặc trực tiếp khi dev)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# WebSocket URL cho realtime (Detection / Tracking / Alert / System)
VITE_WS_URL=ws://localhost:8000/api/v1/ws

# Bật demo realtime khi backend chưa có luồng camera thật (true/false)
VITE_ENABLE_DEMO=true
