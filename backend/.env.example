# =============================================================================
# AEMS Backend - Environment (local development)
# Copy thành `.env` trong thư mục backend/
# =============================================================================

PROJECT_NAME=AEMS
ENVIRONMENT=development
DEBUG=true

# PostgreSQL (async URL dùng driver asyncpg)
POSTGRES_USER=aems
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=aems
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aems:change_me_strong_password@localhost:5432/aems

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_DB=0

# JWT / Security
SECRET_KEY=change_me_generate_a_64_char_hex_secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080
JWT_ALGORITHM=HS256

# Sprint 9 — Enterprise Admin
# Tài khoản admin seed lần đầu (đổi mật khẩu ngay sau khi đăng nhập)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ADMIN_EMAIL=admin@aems.local
# Dùng SQL repo cho admin (Production). Mặc định false → InMemory.
ADMIN_USE_SQL=false
# Rate limit theo IP mỗi phút; bật/tắt endpoint Prometheus /metrics
RATE_LIMIT_PER_MINUTE=120
ENABLE_METRICS=true

# Sprint 10 — DB connection pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Logging
LOG_LEVEL=INFO
LOG_DIR=../logs
